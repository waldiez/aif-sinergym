@techreport{goel2014,
  author       = {Goel, Supriya and Athalye, Rahul A. and Wang, Weimin and Zhang, Jian and Rosenberg, Michael I. and Xie, YuLong and Hart, Philip R. and Mendon, Vrushali V.},
  title        = {Enhancements to ASHRAE Standard 90.1 Prototype Building Models},
  institution  = {Pacific Northwest National Laboratory (PNNL), Richland, WA (United States)},
  annote       = {This report focuses on enhancements to prototype building models used to determine the energy impact of various versions of ANSI/ASHRAE/IES Standard 90.1. Since the last publication of the prototype building models, PNNL has made numerous enhancements to the original prototype models compliant with the 2004, 2007, and 2010 editions of Standard 90.1. Those enhancements are described here and were made for several reasons: (1) to change or improve prototype design assumptions; (2) to improve the simulation accuracy; (3) to improve the simulation infrastructure; and (4) to add additional detail to the models needed to capture certain energy impacts from Standard 90.1 improvements. These enhancements impact simulated prototype energy use, and consequently impact the savings estimated from edition to edition of Standard 90.1.},
  doi          = {10.2172/1129366},
  url          = {https://www.osti.gov/biblio/1129366},
  place        = {United States},
  year         = {2014},
  month        = {04}}

